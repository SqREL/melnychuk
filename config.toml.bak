baseURL = "https://melnychuk.me/"
# include content marked as draft
buildDrafts = false
# include content with publishdate in the future
buildFuture = false
# include content already expired
buildExpired = false
# enable this to make all relative URLs relative to content root. Note that this does not affect absolute URLs.
relativeURLs = true
disableKinds = []
enableRobotsTXT = true
editor = "nano"
languageCode = "en"
language = "en"
theme = "vncnt-hugo"
title = "Vasyl Melnychuk personal homepage"

[markup]
  [markup.goldmark]
    [markup.goldmark.renderer]
      hardWraps = true

[permalinks]
  fixed = ":title/"
  posts = "posts/:slug/"

[params]
  author = "Vasyl Melnychuk"
  email = "vasyl@melnychuk.me"
  description = "Personal homepage"
  bio = "Software Developer"
  avatar = "img/avatar.png"
  favicon = "img/favicon.ico"
  error404 = "There is no such page."

  [params.highlights]
    skills = ["Ruby", "Ruby on Rails", "PostgreSQL", "AWS", "Docker", "Kubernetes", "TypeScript", "Microservices", "Redis", "Kafka"]
    cv_url = "/misc/VasylMelnychukCV.pdf"

  [[params.projects]]
    name = "Microservices Platform"
    description = "Built a scalable microservices architecture using Go and Kubernetes for handling high-traffic workloads"
    url = "https://github.com/sqrel"
    tags = ["Go", "Kubernetes", "Docker", "gRPC"]
    featured = true

  [[params.projects]]
    name = "API Gateway"
    description = "Developed a high-performance API gateway with rate limiting, authentication, and request routing"
    url = "https://github.com/sqrel"
    tags = ["Go", "Redis", "PostgreSQL"]
    featured = true

  [[params.projects]]
    name = "Data Processing Pipeline"
    description = "Created an ETL pipeline for processing large datasets with real-time analytics capabilities"
    url = "https://github.com/sqrel"
    tags = ["Python", "Apache Kafka", "PostgreSQL"]
    featured = false

  [[params.projects]]
    name = "DevOps Automation"
    description = "Automated infrastructure deployment and monitoring using Infrastructure as Code principles"
    url = "https://github.com/sqrel"
    tags = ["Terraform", "AWS", "Ansible"]
    featured = false

  [params.contact]
    github = "https://github.com/sqrel"
    instagram = "https://instagram.com/sqrel"
    linkedin = "https://www.linkedin.com/in/sqrel/"
    telegram = "https://t.me/sqrel/"
    twitter = ""
    ello = ""
